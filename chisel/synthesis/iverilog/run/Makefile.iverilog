# Makefile for Icarus Verilog Simulation
# Open-source alternative to VCS

DESIGN := soc_tb

# Icarus Verilog settings
IVERILOG := iverilog
VVP := vvp
GTKWAVE := gtkwave

# Output files
COMPILE_OUT := $(DESIGN).vvp
WAVE_FILE := $(DESIGN).vcd

# Compiler flags
IVERILOG_FLAGS := -g2005-sv \
                  -Wall \
                  -Wno-timescale \
                  -DIVERILOG \
                  -DPDK_BEHAV \
                  -DRANDOMIZE_REG_INIT

# Include directories
INC_DIRS := -I../top \
            -I../utils \
            -I../tb \
            -I../tb/include

# File lists
RTL_FILES := $(shell cat ../filelist/asic_top.f ../filelist/ip.f ../filelist/lib.f ../filelist/soc.f 2>/dev/null | grep -v "^#" | grep -v "^$$")
TB_FILES := $(shell cat ../filelist/asic_tblist.f 2>/dev/null | grep -v "^#" | grep -v "^$$")

# Default target
.PHONY: all
all: compile

# Compile
.PHONY: compile comp
compile comp:
	@echo "=========================================="
	@echo "Compiling with Icarus Verilog..."
	@echo "=========================================="
	@echo "RTL files: $(words $(RTL_FILES)) files"
	@echo "TB files: $(words $(TB_FILES)) files"
	@echo ""
	$(IVERILOG) $(IVERILOG_FLAGS) $(INC_DIRS) \
		-o $(COMPILE_OUT) \
		-s $(DESIGN) \
		$(RTL_FILES) $(TB_FILES) 2>&1 | tee compile.log
	@echo ""
	@if [ -f $(COMPILE_OUT) ]; then \
		echo "✓ Compilation successful!"; \
		echo "Output: $(COMPILE_OUT)"; \
	else \
		echo "✗ Compilation failed!"; \
		echo "Check compile.log for details"; \
		exit 1; \
	fi

# Simulate
.PHONY: simulate sim
simulate sim: compile
	@echo ""
	@echo "=========================================="
	@echo "Running simulation..."
	@echo "=========================================="
	$(VVP) $(COMPILE_OUT) 2>&1 | tee sim.log
	@echo ""
	@if [ -f $(WAVE_FILE) ]; then \
		echo "✓ Simulation completed!"; \
		echo "Waveform: $(WAVE_FILE)"; \
	else \
		echo "⚠ Simulation completed but no waveform generated"; \
	fi

# View waveform
.PHONY: wave view
wave view:
	@if [ -f $(WAVE_FILE) ]; then \
		echo "Opening waveform with GTKWave..."; \
		$(GTKWAVE) $(WAVE_FILE) &; \
	else \
		echo "Error: Waveform file $(WAVE_FILE) not found!"; \
		echo "Run 'make sim' first"; \
		exit 1; \
	fi

# Run all (compile + simulate)
.PHONY: run
run: sim

# Clean
.PHONY: clean
clean:
	@echo "Cleaning up..."
	rm -f $(COMPILE_OUT) $(WAVE_FILE)
	rm -f *.log *.vcd *.vvp
	rm -f *.fsdb *.vpd
	rm -rf csrc simv.daidir DVEfiles verdiLog
	@echo "✓ Clean complete"

# Help
.PHONY: help
help:
	@echo "Icarus Verilog Simulation Makefile"
	@echo ""
	@echo "Targets:"
	@echo "  make compile (or comp)  - Compile the design"
	@echo "  make simulate (or sim)  - Compile and simulate"
	@echo "  make wave (or view)     - View waveform with GTKWave"
	@echo "  make run                - Compile and simulate"
	@echo "  make clean              - Clean generated files"
	@echo "  make help               - Show this help"
	@echo ""
	@echo "Examples:"
	@echo "  make comp               # Compile only"
	@echo "  make sim                # Compile and simulate"
	@echo "  make wave               # View waveform"
	@echo ""
	@echo "Note: This Makefile uses Icarus Verilog (open-source)"
	@echo "      For VCS simulation, use the original Makefile"

# Show configuration
.PHONY: config
config:
	@echo "Configuration:"
	@echo "  Design: $(DESIGN)"
	@echo "  Compiler: $(IVERILOG)"
	@echo "  Simulator: $(VVP)"
	@echo "  Wave viewer: $(GTKWAVE)"
	@echo "  Output: $(COMPILE_OUT)"
	@echo "  Waveform: $(WAVE_FILE)"
	@echo ""
	@echo "Include directories:"
	@echo "$(INC_DIRS)" | tr ' ' '\n' | grep -v "^$$"
	@echo ""
	@echo "RTL files: $(words $(RTL_FILES))"
	@echo "TB files: $(words $(TB_FILES))"

.PHONY: list-files
list-files:
	@echo "RTL Files:"
	@echo "$(RTL_FILES)" | tr ' ' '\n'
	@echo ""
	@echo "Testbench Files:"
	@echo "$(TB_FILES)" | tr ' ' '\n'
